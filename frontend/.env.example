# Copy this file to .env.local and fill in real values. .env.local is gitignored and never committed.

# Firebase Client SDK (Firebase Console > Project Settings > Your Apps > Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Maps
VITE_GOOGLE_MAPS_API_KEY=

# Backend API base URL (defaults to http://localhost:8000 in dev if unset)
VITE_API_BASE_URL=
