# Non-secret placeholder values used only when running `vitest` locally/in CI.
# firebase/auth and @supabase/supabase-js are mocked in src/test/setup.js,
# so these values are never used to make a real network call.
VITE_FIREBASE_API_KEY=test-api-key
VITE_FIREBASE_AUTH_DOMAIN=test.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=test-project
VITE_FIREBASE_STORAGE_BUCKET=test.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

VITE_SUPABASE_URL=https://test.supabase.co
VITE_SUPABASE_ANON_KEY=test-anon-key

VITE_GOOGLE_MAPS_API_KEY=test-google-maps-key

VITE_API_BASE_URL=http://localhost:8000
