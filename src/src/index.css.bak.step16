@import "tailwindcss";

:root {
  --primary: #7A4BC8;
  --primary-dark: #381D65;
  --primary-light: #7A4BC81A;
}

html, body, #root {
  height: 100%;
  margin: 0;
  padding: 0;
}

/* Bottom nav safe area */
.bottom-nav {
  padding-bottom: max(1rem, env(safe-area-inset-bottom));
}

@keyframes pulse-locate { 0%,100% { transform: scale(1); } 50% { transform: scale(1.1); box-shadow: 0 4px 24px rgba(122,75,200,0.7); } }

/* FORCE MAP CONTAINER VISIBILITY */
.map-container, [class*="map-wrapper"], [class*="mapContainer"] {
    min-height: 100vh !important;
    width: 100vw !important;
    position: relative !important;
    display: block !important;
}
